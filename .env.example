# Copie para .env na raiz. Nada aqui e segredo: sao knobs do lab.

EDGE_PORT=8080

# --- mysql (vira Cloud SQL no GCP) ---
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# --- new-service ---
NODE_ENV=development
LOG_LEVEL=info
NEW_SERVICE_ROUTE_PREFIX=api

# --- new-front (build time; mudar exige rebuild) ---
NEW_FRONT_BASE_PATH=/new/
NEW_FRONT_API_BASE_URL=/api/example
