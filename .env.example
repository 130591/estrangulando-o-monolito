# Copie para .env na raiz. Nada aqui e segredo: sao knobs do lab.

EDGE_PORT=8080

# --- portas dos fronts no host (atalho de debug; o normal e passar pela borda) ---
LEGACY_FRONT_PORT=8081
NEW_FRONT_PORT=8082

# --- mysql (vira Cloud SQL no GCP) ---
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# --- auth (compartilhada pelos dois backends) ---
# O MESMO segredo dos dois lados: e o que faz um token emitido pelo legado
# valer no new-service depois que a borda desviar a rota. Divergir aqui e o
# jeito mais rapido de reproduzir a "sessao dividida" do README.
JWT_SECRET=dev-notes-segredo-local-nao-use-em-producao
JWT_EXPIRES_IN=7d

# --- new-service ---
NODE_ENV=development
LOG_LEVEL=info
NEW_SERVICE_ROUTE_PREFIX=api

# --- new-front (build time; mudar exige rebuild) ---
NEW_FRONT_BASE_PATH=/new/
NEW_FRONT_API_BASE_URL=/api
